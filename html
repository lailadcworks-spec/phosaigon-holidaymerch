<script>
(function () {
  var colors = {
    cream:   { name: "Cream & terracotta", photo: "img/mug-cream.jpg",   wrap: "img/wrap-cream.jpg",   alt: "Phở Saigon mug in cream with a terracotta inside and handle" },
    redwood: { name: "Redwood",            photo: "img/mug-redwood.jpg", wrap: "img/wrap-redwood.jpg", alt: "Phở Saigon mug in deep redwood with a cream inside" },
    olive:   { name: "Olive green",        photo: "img/mug-olive.jpg",   wrap: "img/wrap-olive.jpg",   alt: "Phở Saigon mug in olive green with a cream inside" }
  };
  Object.keys(colors).forEach(function (k) { new Image().src = colors[k].photo; new Image().src = colors[k].wrap; });

  var photo = document.getElementById("mugPhoto");
  var wrap = document.getElementById("wrapImg");
  var label = document.getElementById("colorName");
  var buttons = document.querySelectorAll(".swatch");

  function swap(img, src, alt) {
    if (img.getAttribute("src") === src) return;
    img.classList.add("fading");
    setTimeout(function () { img.src = src; img.alt = alt; img.classList.remove("fading"); }, 160);
  }
  function select(key) {
    var c = colors[key]; if (!c) return;
    buttons.forEach(function (b) { b.setAttribute("aria-pressed", String(b.dataset.key === key)); });
    label.textContent = c.name;
    swap(photo, c.photo, c.alt);
    swap(wrap, c.wrap, "The full illustrated print of the " + c.name.toLowerCase() + " mug, laid flat");
  }
  buttons.forEach(function (b) { b.addEventListener("click", function () { select(b.dataset.key); }); });

  // Lightbox for mockup boards
  var box = document.getElementById("lightbox");
  var boxImg = document.getElementById("lightboxImg");
  var closeBtn = document.getElementById("lightboxClose");
  var lastFocus = null;
  function open(src, alt) { lastFocus = document.activeElement; boxImg.src = src; boxImg.alt = alt; box.hidden = false; closeBtn.focus(); }
  function close() { box.hidden = true; boxImg.src = ""; if (lastFocus) lastFocus.focus(); }
  document.querySelectorAll(".board-btn").forEach(function (b) {
    b.addEventListener("click", function () { open(b.dataset.src, b.dataset.alt); });
  });
  closeBtn.addEventListener("click", close);
  box.addEventListener("click", function (e) { if (e.target === box) close(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !box.hidden) close(); });
})();
</script>

