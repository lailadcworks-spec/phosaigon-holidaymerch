<style>
/* Layout: a proposal lookbook. Hero names the collection and indexes the three items;
   each item then gets its own spread (photos + what it is + details), followed by gifting,
   where it would be sold, the original mockup boards, and what still needs confirming. */
:root {
  --paper: #f7efdf;
  --surface: #fbf6ea;
  --band: #efe2c8;
  --ink: #3a2414;
  --muted: #76594a;
  --redwood: #7b3e12;
  --red: #b5402a;
  --olive: #556b45;
  --line: rgba(123, 62, 18, .18);
  --on-accent: #fbf6ea;
  --scrim: rgba(30, 20, 14, .88);
  --leather: #8a4128;
  --font-display: "Literata", Georgia, "Times New Roman", serif;
  --font-body: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --step--1: .8125rem;
  --step-0: 1rem;
  --step-1: 1.1875rem;
  --step-2: 1.5rem;
  --step-3: clamp(1.75rem, 1.3rem + 2vw, 2.375rem);
  --step-4: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
  --wrap: 1120px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #1e150f; --surface: #271b13; --band: #2f2117; --ink: #f3e6cf; --muted: #c6ad90;
    --redwood: #e3a173; --red: #ec8466; --olive: #a6ba8c; --line: rgba(243, 230, 207, .16);
    --on-accent: #1e150f; --scrim: rgba(10, 7, 5, .92); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --paper: #1e150f; --surface: #271b13; --band: #2f2117; --ink: #f3e6cf; --muted: #c6ad90;
  --redwood: #e3a173; --red: #ec8466; --olive: #a6ba8c; --line: rgba(243, 230, 207, .16);
  --on-accent: #1e150f; --scrim: rgba(10, 7, 5, .92); color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--paper); color: var(--ink);
  font-family: var(--font-body); font-size: var(--step-0); line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
.inner {
  max-width: var(--wrap); margin: 0 auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}
h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.12; text-wrap: balance; margin: 0; }
p { margin: 0; }
a { color: var(--redwood); text-underline-offset: 3px; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; border-radius: 6px; }
.eyebrow { font-size: var(--step--1); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
.section-head { display: flex; flex-direction: column; gap: 10px; max-width: 62ch; }
.section-head h2 { font-size: var(--step-3); }
.section-head p { color: var(--muted); }
.band { background: var(--band); }
img { display: block; }

/* Top bar */
.topbar { border-bottom: 1px solid var(--line); }
.topbar .inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
.brand { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.wordmark { font-weight: 700; letter-spacing: .02em; color: var(--red); font-size: var(--step-1); text-decoration: none; }
.brand small { font-size: var(--step--1); color: var(--muted); }
.topbar nav { display: flex; gap: 20px; flex-wrap: wrap; font-size: var(--step--1); font-weight: 500; }
.topbar nav a { color: var(--muted); text-decoration: none; }
.topbar nav a:hover { color: var(--ink); }

/* Hero */
.hero .inner { padding-block: clamp(36px, 6vw, 72px) clamp(32px, 5vw, 56px); display: flex; flex-direction: column; gap: clamp(28px, 4vw, 44px); }
.hero-copy { display: flex; flex-direction: column; gap: 18px; max-width: 46rem; }
.hero h1 { font-size: var(--step-4); letter-spacing: -.01em; }
.hero h1 em { font-style: italic; font-weight: 500; color: var(--redwood); }
.lede { font-size: var(--step-1); color: var(--muted); max-width: 44ch; line-height: 1.55; }
.lineup { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
.lineup a { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: var(--ink); }
.lineup .thumb { aspect-ratio: 4 / 5; max-width: 100%; border-radius: 18px; overflow: hidden; background: var(--band); }
.lineup .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
.lineup a:hover .thumb img { transform: scale(1.03); }
.lineup .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.lineup h3 { font-size: var(--step-2); }
.lineup span { font-size: var(--step--1); color: var(--muted); text-align: right; }

/* Item spread */
.item .inner { padding-block: clamp(48px, 7vw, 88px); display: flex; flex-direction: column; gap: 28px; }
.spread { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 5vw, 56px); align-items: start; }
.copy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
.copy > p { color: var(--muted); }
.specs { margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 10px 20px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .9375rem; }
.specs dt { color: var(--muted); }
.specs dd { margin: 0; font-weight: 500; }
.hex { font-variant-numeric: tabular-nums; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .8125rem; color: var(--muted); }

/* Mug */
.photo { position: relative; aspect-ratio: 1 / 1; max-width: 100%; border-radius: 22px; overflow: hidden; background: var(--band); }
.photo img { width: 100%; height: 100%; object-fit: cover; transition: opacity .3s ease; }
.fading { opacity: 0; }
.picker { display: flex; flex-direction: column; gap: 10px; }
.picker-label { font-size: var(--step--1); color: var(--muted); }
.picker-label strong { color: var(--ink); font-weight: 600; }
.swatches { display: flex; gap: 10px; flex-wrap: wrap; }
.swatch {
  display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 7px; border-radius: 999px;
  border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-size: .875rem; font-weight: 500; cursor: pointer;
}
.swatch[aria-pressed="true"] { border-color: var(--redwood); box-shadow: 0 0 0 1px var(--redwood); }
.dot { width: 26px; height: 26px; border-radius: 50%; position: relative; flex: none; box-shadow: inset 0 0 0 1px rgba(0,0,0,.15); }
.dot::after { content: ""; position: absolute; inset: 8px; border-radius: 50%; background: var(--dot-in); box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
.wrap-block { display: flex; flex-direction: column; gap: 10px; }
.wrap-scroll { overflow-x: auto; border-radius: 14px; -webkit-overflow-scrolling: touch; }
.wrap-scroll img { width: 100%; min-width: 680px; height: auto; transition: opacity .3s ease; }
.caption { font-size: var(--step--1); color: var(--muted); }
.swipe-hint { display: none; }

.guide-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 32px; margin: 0; padding: 0; list-style: none; }
.guide-grid li { display: flex; flex-direction: column; gap: 2px; padding-top: 12px; border-top: 1px solid var(--line); min-width: 0; }
.vn { font-family: var(--font-display); font-style: italic; font-size: var(--step-2); color: var(--redwood); line-height: 1.2; }
.en { font-size: var(--step--1); font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--olive); }
.guide-grid p { font-size: .9375rem; color: var(--muted); margin-top: 4px; }
.subhead { font-size: var(--step-2); }

/* Pins */
.pins-board { border-radius: 22px; overflow: hidden; background: var(--leather); }
.pins-board img { width: 100%; height: auto; }
.pin-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 0; padding: 0; }
.pin-grid li { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.pin-tile { aspect-ratio: 1 / 1; max-width: 100%; border-radius: 14px; background: var(--leather); display: grid; place-items: center; padding: 10px; overflow: hidden; }
.pin-tile img { max-width: 100%; max-height: 100%; object-fit: contain; }
.pin-grid .vn { font-size: var(--step-1); }
.pin-grid .en { font-size: .6875rem; }

/* Tee */
.tee-gallery { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: auto auto; gap: 12px; }
.tee-gallery figure { margin: 0; border-radius: 18px; overflow: hidden; background: var(--band); }
.tee-gallery img { width: 100%; height: 100%; object-fit: cover; }
.tee-gallery .tall { grid-row: span 2; }

/* Gifting */
.gift-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
.gift-list li { display: grid; grid-template-columns: minmax(0, 13rem) minmax(0, 1fr) minmax(0, 9rem); gap: 16px; align-items: baseline; padding-block: 18px; border-bottom: 1px solid var(--line); }
.gift-list li:first-child { border-top: 1px solid var(--line); }
.gift-list h3 { font-size: var(--step-1); }
.gift-list p { color: var(--muted); font-size: .9375rem; }
.gift-list .pick { font-size: var(--step--1); font-weight: 600; color: var(--olive); text-align: right; }

/* Branches */
.branch-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.branch { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.branch h3 { font-size: var(--step-2); }
.branch .tag { font-size: var(--step--1); font-weight: 600; color: var(--olive); }
.branch p { font-size: .9375rem; color: var(--muted); }

/* Boards */
.boards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 0; padding: 0; }
.board-btn { display: flex; flex-direction: column; gap: 8px; width: 100%; padding: 0; border: 0; background: none; color: var(--ink); font: inherit; text-align: left; cursor: zoom-in; }
.board-btn .frame { aspect-ratio: 1 / 1; max-width: 100%; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
.board-btn img { width: 100%; height: 100%; object-fit: cover; }
.board-btn span { font-size: .875rem; font-weight: 500; }

.lightbox { position: fixed; inset: 0; z-index: 50; background: var(--scrim); display: grid; place-items: center;
  padding: calc(16px + env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) calc(16px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
.lightbox img { max-width: 100%; max-height: 86vh; border-radius: 10px; object-fit: contain; }
.lightbox button { position: absolute; top: calc(14px + env(safe-area-inset-top, 0px)); right: max(14px, env(safe-area-inset-right, 0px));
  border: 0; border-radius: 999px; padding: 8px 16px; background: var(--surface); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }

/* To confirm */
.confirm-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; list-style: none; margin: 0; padding: 0; }
.confirm-grid li { display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 12px; padding-block: 14px; border-bottom: 1px solid var(--line); }
.box { width: 16px; height: 16px; margin-top: 5px; border: 1.5px solid var(--redwood); border-radius: 4px; }
.confirm-grid strong { font-weight: 600; }
.confirm-grid p { color: var(--muted); font-size: .9375rem; }

footer { border-top: 1px solid var(--line); }
footer .inner { padding-block: 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: var(--step--1); color: var(--muted); }
footer .tagline { font-family: var(--font-display); font-style: italic; font-size: var(--step-0); color: var(--ink); }

@media (max-width: 960px) {
  .pin-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .guide-grid, .branch-grid, .boards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gift-list li { grid-template-columns: minmax(0, 11rem) minmax(0, 1fr); }
  .gift-list .pick { grid-column: 2; text-align: left; }
}
@media (max-width: 760px) {
  .spread { grid-template-columns: minmax(0, 1fr); }
  .topbar nav { display: none; }
  .swipe-hint { display: block; }
  .confirm-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 560px) {
  .lineup { grid-template-columns: minmax(0, 1fr); }
  .lineup .thumb { aspect-ratio: 16 / 10; }
  .guide-grid, .branch-grid { grid-template-columns: minmax(0, 1fr); }
  .pin-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gift-list li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
  .gift-list .pick { grid-column: auto; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

